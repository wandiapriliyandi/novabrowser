<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E293B"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- Row Header: Judul & Tombol Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtTabBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#0F172A"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/txtTabTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Judul Halaman Web"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/txtActiveIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AKTIF"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#064E3B"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCloseThisTab"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="✕"
            android:textColor="#EF4444"
            android:background="#334155"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Sub row: URL Halaman -->
    <TextView
        android:id="@+id/txtTabUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="https://domain.com/path"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginTop="6dp" />

</LinearLayout>

